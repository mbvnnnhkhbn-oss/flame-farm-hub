# ============================================
# Supabase (ඔයාගේ අලුත් Supabase project එකෙන් ගන්න)
# supabase.com → Project → Settings → API
# ============================================

# Client-side (browser) — Publishable / anon key
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci...anon-key..."
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side (same values, no VITE_ prefix)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGci...anon-key..."
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-only SECRET — service_role key (කවදාවත් client එකට expose කරන්න එපා)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci...service-role-key..."

# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# ============================================
# Lovable AI (optional — AI features use කරනවා නම් විතරයි)
# ============================================
LOVABLE_API_KEY=""
